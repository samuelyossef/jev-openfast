# Use a standard OpenRouter inference key (not a Management key) and set a spending limit on it.
# You can also paste the key later in Settings -> Model.
OPENROUTER_API_KEY=

# Models (defaults shown)
TYPESAFE_MODEL=typesafe/jev-1.13
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Local server port (open http://127.0.0.1:<port>)
# TYPESAFE_DEMO_PORT=8766

# Advanced: attach to a dedicated Chrome started with --remote-debugging-port.
# scripts/start_windows.ps1 sets these for you on Windows.
# BU_CDP_URL=http://127.0.0.1:9222
# BU_NAME=jev-demo
# JEV_HEADLESS_BROWSER=1

PYTHONUTF8=1
